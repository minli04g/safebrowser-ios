default_platform(:ios)

platform :ios do
  def asc_key
    app_store_connect_api_key(
      key_id: ENV['ASC_KEY_ID'],
      issuer_id: ENV['ASC_ISSUER_ID'],
      key_content: ENV['ASC_KEY_CONTENT'], # base64 of the .p8
      is_key_content_base64: true,
      in_house: false
    )
  end

  # ONE-TIME: creates the distribution cert + appstore profile via the ASC API
  # and stores them (encrypted) in the private match repo (over SSH — the CI job
  # loads the deploy key via ssh-agent). Run via workflow_dispatch once.
  desc 'Initialize signing certs in the match repo (run once)'
  lane :init_signing do
    setup_ci
    match(type: 'appstore', api_key: asc_key, readonly: false)
  end

  # ONE-TIME: create the App Store Connect app record so TestFlight uploads
  # have a destination. The App ID already exists in the dev portal (push
  # enabled), so we skip that and only create the ASC app.
  desc 'Create the App Store Connect app record (run once)'
  lane :create_app do
    produce(
      api_key: asc_key,
      app_identifier: 'top.fancytech.sf',
      app_name: "Min's SafeBrowser Parent",
      language: 'English',
      sku: 'safebrowser-parent-ios',
      skip_itc: false,
      skip_devcenter: true
    )
  end

  desc 'Build and upload to TestFlight'
  lane :beta do
    api_key = asc_key
    setup_ci
    match(type: 'appstore', api_key: api_key, readonly: true)
    build_app(
      project: 'ios/App/App.xcodeproj', # SPM project — no .xcworkspace
      scheme: 'App',                    # Capacitor's default iOS scheme
      export_method: 'app-store'
    )
    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end
end
